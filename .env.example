# ---------------------------------------------------------------------------
# RAISEVIA — environment configuration
#
# Copy to `.env` and fill in. Every value the app reads is listed below.
#   cp .env.example .env
#
# `.env` must never be committed. Only `NEXT_PUBLIC_*` values reach the browser;
# everything else stays server-side.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. The app uses the pg driver through the Prisma
# adapter (`@prisma/adapter-pg`), which reads this via `dotenv` in `lib/db.ts`.
#
# This is the one variable with no fallback: the app throws on boot without it.
# The schema itself declares no `url`, so this is the only source of truth.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autopitch?schema=public"

# --- OpenAI -----------------------------------------------------------------
# Used for deck generation, slide copy, image generation, the investor review,
# Q&A practice, deck chat, brand kit suggestions, and fundraising kit assets.
# Create one at https://platform.openai.com/api-keys
#
# Only needed if you are NOT using placeholder images and the AI features.
OPENAI_API_KEY="sk-..."

# --- ImageKit ---------------------------------------------------------------
# Private key for uploading generated slide images and brand kit logos.
# Find it in your ImageKit dashboard under Developer Options → API Keys.
#
# Without this, slide image generation fails at the upload step (after OpenAI has
# already spent the tokens generating the image).
IMAGEKIT_PRIVATE_KEY="private_..."

# Optional. The stock endpoint `ik.imagekit.io` is always allowed for
# `next/image` optimization (see `next.config.ts`). Set this ONLY if you use a
# custom ImageKit URL endpoint, otherwise slide images will not render.
# IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-endpoint-id"

# --- App URL ----------------------------------------------------------------
# The public origin of the deployment. Used for:
#   - `<link rel="canonical">` and Open Graph URLs in `app/layout.tsx`
#   - building investor share links in the share manager
#
# WARNING: if this is unset, the share manager renders links as a bare
# `/share/<token>` path. Those look valid when copied but resolve to nothing in
# an email to an investor. Always set this before sharing a deck.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Inngest (background deck generation) -----------------------------------
# Read implicitly by the Inngest SDK, not by application code. Required in
# production for the `deck/generate` background job to run. For local
# development, skip these and run `pnpm inngest:dev` alongside `pnpm dev`,
# which runs the functions locally without a cloud account.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# --- Development only -------------------------------------------------------
# Set to "true" to swap generated slide imagery for a free stock photo from
# picsum.photos. Skips the OpenAI image call entirely, so local iteration costs
# nothing — useful before you have an ImageKit key set up.
#
# Must never be "true" in production; every deck would ship stock photos.
USE_PLACEHOLDER_IMAGES="false"
