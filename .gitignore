# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# local env (committed as .env.example only)
.env.local
.env*.local
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# database
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# pnpm
.pnpm-store/

# local tooling
.agents/
.claude/
.windsurf/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed, or nobody can discover what config the
# app needs. Without this, the later `.env*` rule above wins over the negation on
# line 31 and `.env.example` is silently never tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
bin/inngest.exe
